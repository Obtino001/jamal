    },
    {
      "type": "text",
      "id": "hours_2_label",
      "label": "Hours Row 2 Label",
      "default": "Fredag:"
    },
    {
      "type": "text",
      "id": "hours_2_text",
      "label": "Hours Row 2 Text",
      "default": "09.00 - 15.30"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email Label",
      "default": "E-mail:"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email Address",
      "default": "kundeservice@georgjensen.com"
    },
    {
      "type": "text",
      "id": "additional_info_label",
      "label": "Additional Info Label (Optional)"
    },
    {
      "type": "text",
      "id": "additional_info_text",
      "label": "Additional Info Text (Optional)"
    },
    {
      "type": "header",
      "content": "Store Locator Box"
    },
    {
      "type": "text",
      "id": "store_locator_heading",
      "label": "Store Locator Heading",
      "default": "Besøg vores butikker"
    },
    {
      "type": "textarea",
      "id": "store_locator_text",
      "label": "Store Locator Text",
