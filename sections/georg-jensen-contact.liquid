      "default": "Kundeservice Åbningstider"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone Label",
      "default": "Telefon:"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number",
      "default": "+45 38 14 98 98"
    },
    {
      "type": "text",
      "id": "hours_1_label",
      "label": "Hours Row 1 Label",
      "default": "Mandag - Torsdag:"
    },
    {
      "type": "text",
      "id": "hours_1_text",
      "label": "Hours Row 1 Text",
