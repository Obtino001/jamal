{% comment %}
  Georg Jensen Contact Us Section - 1-to-1 Replica
{% endcomment %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="georg-contact-section section-{{ section.id }}-padding">
  <div class="georg-container page-width">
    <div class="georg-contact-header scroll-trigger animate--slide-in">
      <span class="georg-story-tag">{{ section.settings.story_tag }}</span>
      <h1 class="georg-contact-title georg-serif">{{ section.settings.title }}</h1>
      <p class="georg-contact-subtitle georg-sans">
        {{ section.settings.subtitle }}
      </p>
    </div>

    <div class="georg-contact-grid">
      <!-- Direct Info Column -->
      <div class="georg-contact-info-card scroll-trigger animate--slide-in">
        <h3 class="georg-serif">{{ section.settings.support_heading }}</h3>
        
        {%- if section.settings.phone != blank -%}
        <div class="georg-info-row">
          <strong>{{ section.settings.phone_label }}</strong>
          <span>{{ section.settings.phone }}</span>
        </div>
        {%- endif -%}

        {%- if section.settings.hours_1_text != blank -%}
        <div class="georg-info-row">
          <strong>{{ section.settings.hours_1_label }}</strong>
          <span>{{ section.settings.hours_1_text }}</span>
        </div>
        {%- endif -%}

        {%- if section.settings.hours_2_text != blank -%}
        <div class="georg-info-row">
          <strong>{{ section.settings.hours_2_label }}</strong>
          <span>{{ section.settings.hours_2_text }}</span>
        </div>
        {%- endif -%}

        {%- if section.settings.email != blank -%}
        <div class="georg-info-row">
          <strong>{{ section.settings.email_label }}</strong>
          <span>{{ section.settings.email }}</span>
        </div>
        {%- endif -%}
        
        {%- if section.settings.additional_info_text != blank -%}
        <div class="georg-info-row">
          <strong>{{ section.settings.additional_info_label }}</strong>
          <span>{{ section.settings.additional_info_text }}</span>
        </div>
        {%- endif -%}

        <div class="georg-store-locator-box">
          <h4 class="georg-serif">{{ section.settings.store_locator_heading }}</h4>
          <p class="georg-sans">{{ section.settings.store_locator_text }}</p>
          {%- if section.settings.store_locator_btn_text != blank -%}
            <a href="{{ section.settings.store_locator_url | default: '#' }}" class="button-georg-black">{{ section.settings.store_locator_btn_text }}</a>
          {%- endif -%}
        </div>
      </div>

      <!-- Form Column -->
      <div class="georg-contact-form-card scroll-trigger animate--slide-in">
        <h3 class="georg-serif">{{ section.settings.form_heading }}</h3>
        {%- form 'contact', id: 'GeorgContactForm' -%}
          {%- if form.posted_successfully? -%}
            <div class="form-status-success" style="margin-bottom: 20px; padding: 10px; background: #e6f4ea; color: #1e4620; text-align: center; font-weight: 500;">
              {{ section.settings.success_message }}
            </div>
          {%- elsif form.errors -%}
            <div class="form-status-error" style="margin-bottom: 20px; padding: 10px; background: #fce8e6; color: #c5221f; text-align: center; font-weight: 500;">
              {{ section.settings.error_message }}
            </div>
          {%- endif -%}

          <div class="georg-field">
            <label for="ContactName" class="georg-label">Navn *</label>
            <input type="text" id="ContactName" name="contact[name]" class="georg-input" required>
          </div>

          <div class="georg-field">
            <label for="ContactEmail" class="georg-label">E-mail *</label>
            <input type="email" id="ContactEmail" name="contact[email]" class="georg-input" required>
          </div>

          <div class="georg-field">
            <label for="ContactOrder" class="georg-label">Ordrenummer (valgfrit)</label>
            <input type="text" id="ContactOrder" name="contact[order_number]" class="georg-input">
          </div>

          <div class="georg-field">
            <label for="ContactMessage" class="georg-label">Din besked *</label>
            <textarea id="ContactMessage" name="contact[body]" rows="5" class="georg-input" required></textarea>
          </div>

          <button type="submit" class="button-georg-black">{{ section.settings.form_btn_text }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

<style>
  .georg-contact-section {
    background-color: #ffffff;
    font-family: var(--georg-font-sans);
  }

  .georg-contact-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 50px auto;
  }

  .georg-contact-title {
    font-size: 40px;
    font-weight: 400;
    color: #111111;
    margin: 10px 0 16px 0;
  }

  .georg-contact-subtitle {
    font-size: 15px;
    color: #555555;
    line-height: 1.6;
  }

  .georg-contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
  }

  .georg-contact-info-card, .georg-contact-form-card {
    background: #fbfbfb;
    border: 1px solid #eeeeee;
    padding: 40px;
  }

  .georg-contact-info-card h3, .georg-contact-form-card h3 {
    font-size: 26px;
    font-weight: 400;
    margin: 0 0 24px 0;
    color: #111111;
  }

  .georg-info-row {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid #eeeeee;
    font-size: 13px;
  }

  .georg-store-locator-box {
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid #e5e5e5;
  }

  .georg-store-locator-box h4 {
    font-size: 20px;
    margin: 0 0 8px 0;
  }

  .georg-store-locator-box p {
    font-size: 13px;
    color: #666;
    margin-bottom: 20px;
  }

  .georg-field {
    margin-bottom: 20px;
  }

  .georg-label {
    display: block;
    font-size: 12px;
    font-weight: 500;
    margin-bottom: 6px;
    color: #222;
  }

  .georg-input {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #cccccc;
    outline: none;
    font-size: 13px;
    background: #ffffff;
    border-radius: 0;
  }

  .georg-input:focus {
    border-color: #000000;
  }

  @media screen and (max-width: 749px) {
    .georg-contact-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
</style>

