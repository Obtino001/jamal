{% comment %}
  Georg Jensen recommendation card (tabs swiper style)
  Accepts:
  - product: {Object}
  - low_stock_threshold: {Number} optional, default 1
  - show_stock: {Boolean} optional
  - set_builder: {Boolean} optional — selectable tile with size picker
{% endcomment %}

{%- liquid
  assign threshold = low_stock_threshold | default: 1
  assign show_stock_status = show_stock
  if show_stock_status == nil
    assign show_stock_status = true
  endif
  assign is_set_builder = set_builder | default: false

  assign subtitle = product.vendor
  if subtitle == blank and product.tags.size > 0
    assign subtitle = product.tags | join: ', '
  endif

  assign inventory_qty = product.selected_or_first_available_variant.inventory_quantity
  assign manage_stock = product.selected_or_first_available_variant.inventory_management

  assign secondary_image = blank
  for media in product.media
    if media.media_type == 'image' and media.id != product.featured_media.id
      assign secondary_image = media
      break
    endif
  endfor

  assign size_option_index = blank
  assign size_option_name = blank
  assign has_size_option = false
  for option in product.options_with_values
    assign option_down = option.name | downcase
    if option_down contains 'size' or option_down contains 'størrelse' or option_down contains 'storrelse'
      assign size_option_index = forloop.index0
      assign size_option_name = option.name
      assign has_size_option = true
    endif
  endfor
-%}

<article
  class="gj-reco-card{% if secondary_image != blank %} has-secondary{% endif %}{% if is_set_builder %} gj-reco-card--set{% endif %}"
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
  data-product-title="{{ product.title | escape }}"
  {% if is_set_builder %}
    data-gj-set-card
    data-size-option-index="{{ size_option_index }}"
    aria-pressed="false"
  {% endif %}
>
  {%- if is_set_builder -%}
    <button type="button" class="gj-reco-card__media gj-reco-card__media--select" data-gj-set-toggle aria-label="Vælg {{ product.title | escape }}">
      <span class="gj-reco-card__marker" aria-hidden="true"></span>
      {%- if product.featured_media != blank -%}
        {{
          product.featured_media
          | image_url: width: 800
          | image_tag:
            loading: 'lazy',
            class: 'gj-reco-card__img gj-reco-card__img--primary',
            widths: '300, 400, 600, 800',
            sizes: '(min-width: 990px) 22vw, 45vw',
            alt: product.title
        }}
        {%- if secondary_image != blank -%}
          {{
            secondary_image
            | image_url: width: 800
            | image_tag:
              loading: 'lazy',
              class: 'gj-reco-card__img gj-reco-card__img--secondary',
              widths: '300, 400, 600, 800',
              sizes: '(min-width: 990px) 22vw, 45vw',
              alt: product.title
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'gj-reco-card__placeholder' }}
      {%- endif -%}
    </button>
  {%- else -%}
    <a href="{{ product.url }}" class="gj-reco-card__media">
      {%- if product.featured_media != blank -%}
        {{
          product.featured_media
          | image_url: width: 800
          | image_tag:
            loading: 'lazy',
            class: 'gj-reco-card__img gj-reco-card__img--primary',
            widths: '300, 400, 600, 800',
            sizes: '(min-width: 990px) 22vw, 45vw',
            alt: product.title
        }}
        {%- if secondary_image != blank -%}
          {{
            secondary_image
            | image_url: width: 800
            | image_tag:
              loading: 'lazy',
              class: 'gj-reco-card__img gj-reco-card__img--secondary',
              widths: '300, 400, 600, 800',
              sizes: '(min-width: 990px) 22vw, 45vw',
              alt: product.title
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'gj-reco-card__placeholder' }}
      {%- endif -%}
    </a>
  {%- endif -%}

  <div class="gj-reco-card__info">
    <div class="gj-reco-card__title-row">
      {%- if is_set_builder -%}
        <a href="{{ product.url }}" class="gj-reco-card__title">{{ product.title }}</a>
      {%- else -%}
        <a href="{{ product.url }}" class="gj-reco-card__title">{{ product.title }}</a>
      {%- endif -%}
      <button
        type="button"
        class="gj-reco-card__wishlist"
        aria-label="Add to wishlist"
        data-gj-wishlist-toggle
        data-product-handle="{{ product.handle }}"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
      </button>
    </div>

    {%- if subtitle != blank -%}
      <p class="gj-reco-card__material">{{ subtitle }}</p>
    {%- endif -%}

    <p class="gj-reco-card__price">{{ product.price_min | money_without_trailing_zeros | replace: ' kr.', ' DKK' | replace: ' kr', ' DKK' }}</p>

    {%- if is_set_builder -%}
      <div class="gj-set-card__size" data-gj-set-size hidden>
        <label class="visually-hidden" for="SetSize-{{ product.id }}">Vælg størrelse</label>
        <select id="SetSize-{{ product.id }}" class="gj-set-card__size-select" data-gj-set-size-select>
          <option value="" selected disabled>Vælg størrelse</option>
          {%- if has_size_option -%}
            {%- for option in product.options_with_values -%}
              {%- if forloop.index0 == size_option_index -%}
                {%- for value in option.values -%}
                  {%- liquid
                    assign matching_variant = blank
                    for variant in product.variants
                      assign variant_opt = variant.options[size_option_index]
                      if variant_opt == value and variant.available
                        assign matching_variant = variant
                        break
                      endif
                    endfor
                  -%}
                  {%- if matching_variant != blank -%}
                    <option value="{{ matching_variant.id }}" data-variant-title="{{ matching_variant.title | escape }}">{{ value }}</option>
                  {%- else -%}
                    <option value="" disabled>{{ value }} — udsolgt</option>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- for variant in product.variants -%}
              {%- if variant.available -%}
                <option value="{{ variant.id }}" data-variant-title="{{ variant.title | escape }}">
                  {%- if product.has_only_default_variant -%}One size{%- else -%}{{ variant.title }}{%- endif -%}
                </option>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </select>
      </div>
      <script type="application/json" data-gj-set-variants>
        {
          "id": {{ product.id | json }},
          "title": {{ product.title | json }},
          "handle": {{ product.handle | json }},
          "variants": [
            {%- for variant in product.variants -%}
              {
                "id": {{ variant.id | json }},
                "title": {{ variant.title | json }},
                "available": {{ variant.available | json }},
                "options": {{ variant.options | json }}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        }
      </script>
    {%- endif -%}

    {%- if show_stock_status and manage_stock and product.available and inventory_qty > 0 and inventory_qty <= threshold -%}
      <p class="gj-reco-card__stock">Only {{ inventory_qty }} left</p>
    {%- endif -%}
  </div>
</article>
