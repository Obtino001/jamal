        },
        "text_nnyDQm": {
          "type": "text",
          "settings": {
            "text": "<p>Hver dag lægges der sten til side i minerne. Ikke fordi de er falske eller svage, men fordi de ikke er ens nok: en ridse i overfladen, en sky i det indre, en kant der aldrig blev jævn. De ender i bunkerne udenfor.</p><p>Det er dem, vi kommer efter.</p>"
          }
        },
